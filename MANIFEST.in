include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md

# Paquete: código, shaders Vulkan y el marcador PEP 561 para mypy [audit r3b-09].
recursive-include src *.py
recursive-include src *.comp
include src/m2m/py.typed

# El sdist lleva docs, tests y ejemplos para que se pueda revisar y validar desde el
# tarball sin clonar el repo [audit r3b-09].
graft docs
graft tests
graft examples

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
global-exclude *.log
