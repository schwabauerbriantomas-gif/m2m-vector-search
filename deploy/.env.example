# Copiá a deploy/.env (docker compose lo lee desde el directorio del compose) o exportá
# las variables en la shell. Las dos son REQUERIDAS: compose falla si falta alguna.
# deploy/.env está en .gitignore; este archivo de ejemplo no.
#
# Generá cada clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
M2M_API_KEY=cambiar-clave-de-los-edges
M2M_COORDINATOR_API_KEY=cambiar-clave-del-coordinator

# Opcionales (las que lee src/):
# M2M_CORS_ORIGINS=https://app.ejemplo.com   # src/m2m/api/edge_api.py:240; default "*" (abierta)
# M2M_HMAC_SECRET=...                         # src/m2m/storage/persistence.py:440,455,583,599 (checkpoints firmados)
# M2M_HOST / M2M_PORT sólo aplican a `python -m m2m`; el CMD de este compose fija --host/--port.
